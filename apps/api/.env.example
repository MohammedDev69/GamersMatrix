# Supabase Postgres (use Dashboard → Database → Connect → ORM → Prisma)
# Prefer the pooler (IPv4). Direct db.PROJECT_REF.supabase.co is often IPv6-only.
# Runtime: transaction pooler port 6543. Username is postgres.PROJECT_REF
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"
# Migrations: session pooler port 5432 (same host/user)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Auth
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Comma-separated app admins. Roles are always read from the commerce User table.
SUPABASE_ADMIN_EMAILS="owner@example.com"

# The seed deletes commerce data. Enable only for a new development project.
SEED_ALLOW_RESET="false"

# API
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Public URL for media links / webhooks (set to your deployed API origin)
# API_PUBLIC_URL="https://api.example.com"
NODE_ENV="development"

# Redis cache (docker compose service `redis`)
# Falls back to in-memory cache if Redis is unreachable.
REDIS_URL="redis://127.0.0.1:6379"
# REDIS_DISABLED="true"

# Store defaults (optional overrides; authoritative values also live in StoreSettings)
STORE_CURRENCY="EGP"
STORE_DEFAULT_LOCALE="ar"
STORE_TIMEZONE="Africa/Cairo"

# Paymob payment provider
# Leave SECRET/PUBLIC/INTEGRATION empty for development mock checkout
# (auto-fulfill after order create). Never claim live payments work without these set.
# PAYMOB_HMAC_SECRET: required whenever Paymob is configured OR NODE_ENV=production
# (webhooks fail-closed). Empty secret is accepted only in local mock mode.
PAYMOB_API_KEY=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""
PAYMOB_BASE_URL="https://accept.paymob.com/v1"

# Email adapter — empty = development preview only (see apps/api/docs/EMAIL.md)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional media uploads (Phase 5+)
# UPLOAD_MAX_BYTES="5242880"
# MEDIA_STORAGE_PATH="./uploads"
